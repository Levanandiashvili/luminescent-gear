  "send": {
    "nav": "",
    "title": "Send your music",
    "blocks": [
      {
        "title": "Send",
        "text": "Email artist, release title, track count, release date and format. One download link: all mixes in one zipped folder, 1–2 references, notes."
      },
      {
        "title": "Format",
        "text": "Stereo WAV or AIFF, 24‑bit or 32‑bit float, session sample rate. No SRC, normalising or dither."
      },
      {
        "title": "Levels",
        "text": "Peaks −10 to −4 dBFS, never above −3. No limiter or clipper on the mix bus. A bus compressor that's part of the sound can stay; note it."
      },
      {
        "title": "Files",
        "text": "1–2 s of silence at each end, fades printed. Named: track number, artist, title."
      },
      {
        "title": "Stems",
        "text": "6–8 groups, effects printed, same start and length. Add the stereo mix. One folder per song."
      },
      {
        "title": "Vinyl",
        "text": "De-ess vocals, or send them as a stem. Side split and running order with side times. Book the cut early."
      },
      {
        "title": "Return",
        "text": "Masters as a download. Vinyl masters go straight to your cutting engineer or pressing plant."
      }
    ],
    "guideButton": "Full guide (PDF)",
    "guideText": "Levels, formats, stems, vinyl and loudness in detail."
  },
