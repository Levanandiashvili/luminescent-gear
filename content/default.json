  "services": {
    "nav": "Services",
    "title": "Services",
    "items": [
      {
        "title": "Mastering",
        "text": "Stereo masters for streaming and download, delivered as 24‑bit WAV, with 16‑bit/44.1 kHz versions on request."
      },
      {
        "title": "Stem mastering",
        "text": "Mastering from grouped stems rather than one stereo file, for finer control over each part of the mix. The balance stays as you set it."
      },
      {
        "title": "Mixing",
        "text": "Mixing from your multitrack session, with the master included."
      },
      {
        "title": "Vinyl master",
        "text": "A dedicated master for the cut, with a centred low end, controlled sibilance and gentler limiting, sent straight to your cutting engineer or pressing plant. We don't cut lacquers."
      }
    ]
  },
